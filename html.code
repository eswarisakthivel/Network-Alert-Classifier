<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Digital Logic Based Network Alert Classifier</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Custom Styles -->
  <link rel="stylesheet" href="css/styles.css">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">

  <!-- Navigation Bar -->
  <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
    <div class="flex items-center gap-3">
      <span class="text-2xl">🛡️</span>
      <div>
        <h1 class="font-bold text-lg leading-none">Network Alert Classifier</h1>
        <p class="text-xs text-slate-400 mt-1">EC2201 • Digital Logic Fundamentals</p>
      </div>
    </div>
    <div class="flex items-center gap-4 text-sm text-slate-400">
      <span>Developer: <strong class="text-slate-200">Shanmuga Eswari Sakthivel</strong></span>
      <span class="bg-indigo-500/10 text-indigo-400 px-3 py-1 rounded-full text-xs font-mono border border-indigo-500/20">ADS Sec B</span>
    </div>
  </header>

  <!-- Main Content Grid -->
  <main class="flex-1 p-6 max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-6">
    
    <!-- Left Panel: Input Controls & K-Map (5 cols) -->
    <section class="lg:col-span-5 flex flex-col gap-6">
      
      <!-- 4-Bit Switchboard -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4 flex items-center justify-between">
          <span>Binary Inputs (X = [A, B, C, D])</span>
          <span id="state-badge" class="px-2.5 py-0.5 rounded text-xs font-bold bg-emerald-500/20 text-emerald-400">NORMAL</span>
        </h2>
        <div class="grid grid-cols-2 gap-4" id="switchboard-container">
          <!-- Dynamically populated by JS -->
        </div>
      </div>

      <!-- K-Map Matrix -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg flex-1">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4">
          4-Variable Karnaugh Map (K-Map)
        </h2>
        <div id="kmap-grid" class="grid grid-cols-5 gap-1 font-mono text-center text-xs">
          <!-- Dynamically populated by kmap.js -->
        </div>
      </div>
    </section>

    <!-- Right Panel: SVG Circuit & Telemetry (7 cols) -->
    <section class="lg:col-span-7 flex flex-col gap-6">
      
      <!-- Dynamic SVG Circuit Visualizer -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4">
          Hardware Combinatorial Logic Schematic
        </h2>
        <div class="w-full h-64 bg-slate-950 rounded-lg border border-slate-800/60 p-2 relative flex items-center justify-center">
          <svg id="circuit-svg" class="w-full h-full" viewBox="0 0 600 240"></svg>
        </div>
      </div>

      <!-- Telemetry Chart -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg flex-1">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4">
          Live Packet Processing Latency (ns)
        </h2>
        <div class="h-48 w-full">
          <canvas id="telemetry-chart"></canvas>
        </div>
      </div>
    </section>
  </main>

  <!-- Modular JavaScript Scripts -->
  <script src="js/kmap.js"></script>
  <script src="js/circuit.js"></script>
  <script src="js/telemetry.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
